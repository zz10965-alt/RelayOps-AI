# Copy to .env locally; never commit actual secrets. Uvicorn --env-file requires python-dotenv,
# so use a secure environment injection method or shell export instead.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_TOOL_TOKEN=
RELAYOPS_DB=.data/relayops.sqlite3

# Configure this in Dify Workflow environment. Optional local mirror for preflight only.
BUSINESS_API_URL=https://relayops-api.example.invalid
# Dify BUSINESS_API_TOKEN must equal the real server DIFY_TOOL_TOKEN (do not commit).

# Railway Docker defaults to protected public-demo mode. Never put actual tokens here.
# RELAYOPS_PUBLIC_DEMO=1
# RELAYOPS_DEMO_TOKEN= (private operator token, >=32 characters)
# RELAYOPS_CORS_ORIGINS=https://your-frontend.vercel.app
# RELAYOPS_DB=/data/relayops.sqlite3
# RELAYOPS_ALLOW_MODEL_EXECUTION=0 (keep disabled until explicit owner approval)
# DIFY_TOOL_TOKEN must differ from operator token and be >=32 characters in public mode.
# Vercel: only VITE_API_BASE_URL=https://your-backend.up.railway.app is public.
