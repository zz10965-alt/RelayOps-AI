# Copy to .env locally; never commit actual secrets. Uvicorn --env-file requires python-dotenv,
# so use a secure environment injection method or shell export instead.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_TOOL_TOKEN=
RELAYOPS_DB=.data/relayops.sqlite3

# Configure this in Dify Workflow environment. Optional local mirror for preflight only.
BUSINESS_API_URL=https://relayops-api.example.invalid
# Dify BUSINESS_API_TOKEN must equal the real server DIFY_TOOL_TOKEN (do not commit).
